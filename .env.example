# Runtime
NODE_ENV="production"

# Supabase auth and data
# Get the publishable key from Supabase Dashboard > Connect > Frameworks > React.
VITE_SUPABASE_URL="https://erejgwkyxibliiusbekl.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
# Legacy projects can use VITE_SUPABASE_ANON_KEY instead of VITE_SUPABASE_PUBLISHABLE_KEY.

# Gemini AI coach
# Keep this server-side only. Do not create VITE_GEMINI_API_KEY.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3-flash-preview"

# Razorpay payments
RAZORPAY_KEY_ID="YOUR_RAZORPAY_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"
VITE_RAZORPAY_KEY_ID="YOUR_RAZORPAY_KEY_ID"

